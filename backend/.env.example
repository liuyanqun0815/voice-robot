VOICE_ROBOT_APP_ENV=development
VOICE_ROBOT_APP_PORT=8000

# true: use mock adapters for local tests
# false: use Tencent ASR + Volcano TTS live connections
VOICE_ROBOT_MOCK_STREAMING_ENABLED=true

# Tencent realtime ASR
VOICE_ROBOT_TENCENT_ASR_APP_ID=1257993331
VOICE_ROBOT_TENCENT_ASR_SECRET_ID=replace_with_secret_id
VOICE_ROBOT_TENCENT_ASR_SECRET_KEY=replace_with_secret_key
VOICE_ROBOT_TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh_large
VOICE_ROBOT_TENCENT_ASR_NEED_VAD=1
VOICE_ROBOT_TENCENT_ASR_VAD_SILENCE_TIME_MS=500
VOICE_ROBOT_TENCENT_ASR_NOISE_THRESHOLD=0.8

# Volcano TTS v3 双向流式（与官方 bidirection demo：X-Api-* 头 + 二进制帧）
# 文档端点默认：wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOICE_ROBOT_VOLCANO_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOICE_ROBOT_VOLCANO_TTS_APP_ID=6051042308
VOICE_ROBOT_VOLCANO_TTS_ACCESS_TOKEN=replace_with_token
# 可选；留空则按音色自动选 resource_id（S_ 开头为 megatts，否则 volc.service_type.10029）
VOICE_ROBOT_VOLCANO_TTS_RESOURCE_ID=
VOICE_ROBOT_VOLCANO_TTS_VOICE_TYPE=zh_female_qingxinnvsheng
VOICE_ROBOT_VOLCANO_TTS_AUDIO_FORMAT=mp3
VOICE_ROBOT_VOLCANO_TTS_SAMPLE_RATE=24000

# DeepAgent + Volcano Ark(OpenAI-compatible)
VOICE_ROBOT_DEEPAGENT_ENABLED=true
VOICE_ROBOT_DEEPAGENT_SYSTEM_PROMPT=你是一个简洁、专业的语音助手。
VOICE_ROBOT_DEEPAGENT_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOICE_ROBOT_DEEPAGENT_ARK_API_KEY=replace_with_ark_api_key
VOICE_ROBOT_DEEPAGENT_ARK_MODEL=doubao-1.5-lite-32k
VOICE_ROBOT_DEEPAGENT_TIMEOUT_SECONDS=30
VOICE_ROBOT_DEEPAGENT_TEMPERATURE=0.2
