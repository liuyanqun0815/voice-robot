VOICE_ROBOT_APP_ENV=development
VOICE_ROBOT_APP_PORT=8000

# true: use mock adapters for local tests
# false: use Tencent ASR + Volcano TTS live connections
VOICE_ROBOT_MOCK_STREAMING_ENABLED=true

# WebSocket 建连后开场白（不经过 LLM；多行可用 \n）
VOICE_ROBOT_GREETING_ENABLED=true
# VOICE_ROBOT_GREETING_TEXT=Hi，我是SCNet专属支持工程师...\n如果您有其他问题...
VOICE_ROBOT_GREETING_TTS_ENABLED=true
# 开场白打字机：每片字符数、片间间隔(ms)
# VOICE_ROBOT_GREETING_STREAM_CHUNK_CHARS=2
# VOICE_ROBOT_GREETING_STREAM_INTERVAL_MS=40

# Tencent realtime ASR
VOICE_ROBOT_TENCENT_ASR_APP_ID=1257993331
VOICE_ROBOT_TENCENT_ASR_SECRET_ID=replace_with_secret_id
VOICE_ROBOT_TENCENT_ASR_SECRET_KEY=replace_with_secret_key
VOICE_ROBOT_TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh_large
VOICE_ROBOT_TENCENT_ASR_NEED_VAD=1
VOICE_ROBOT_TENCENT_ASR_VAD_SILENCE_TIME_MS=500
VOICE_ROBOT_TENCENT_ASR_NOISE_THRESHOLD=0.8

# Volcano TTS v3 双向流式（与官方 bidirection demo：X-Api-* 头 + 二进制帧）
# 文档端点默认：wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOICE_ROBOT_VOLCANO_TTS_WS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOICE_ROBOT_VOLCANO_TTS_APP_ID=6051042308
VOICE_ROBOT_VOLCANO_TTS_ACCESS_TOKEN=replace_with_token
# 可选；留空则按音色自动选 resource_id（S_ 开头为 megatts，否则 volc.service_type.10029）
VOICE_ROBOT_VOLCANO_TTS_RESOURCE_ID=
VOICE_ROBOT_VOLCANO_TTS_VOICE_TYPE=zh_female_qingxinnvsheng
VOICE_ROBOT_VOLCANO_TTS_AUDIO_FORMAT=mp3
VOICE_ROBOT_VOLCANO_TTS_SAMPLE_RATE=24000

# DeepAgent + Volcano Ark(OpenAI-compatible)
VOICE_ROBOT_DEEPAGENT_ENABLED=true
VOICE_ROBOT_DEEPAGENT_SYSTEM_PROMPT=你是一个简洁、专业的语音助手。
VOICE_ROBOT_DEEPAGENT_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOICE_ROBOT_DEEPAGENT_ARK_API_KEY=replace_with_ark_api_key
VOICE_ROBOT_DEEPAGENT_ARK_MODEL=doubao-1.5-lite-32k
VOICE_ROBOT_DEEPAGENT_TIMEOUT_SECONDS=30
VOICE_ROBOT_DEEPAGENT_TEMPERATURE=0.2
# index 命中不足时用 Ark 从 index 选 wiki 路径（对齐 llm-wiki query.py，工具内多 1 次 LLM）
# 未命中 index/分类关联时，用 Ark 读 index.md 选最相关 wiki 页（query_kefu_wiki 内 1 次额外 LLM）
VOICE_ROBOT_WIKI_QUERY_LLM_FALLBACK_ENABLED=false
# VOICE_ROBOT_WIKI_QUERY_INDEX_LLM_MAX_PAGES=5

# 客户消息含 http 链接：图片走 Ark 视觉 OCR（关注标注），网页抓取正文后送入 DeepAgent
VOICE_ROBOT_LINK_ENRICHMENT_ENABLED=true
# 视觉模型（需支持 image_url；留空则用 DEEPAGENT_ARK_MODEL）
# VOICE_ROBOT_LINK_ENRICHMENT_VISION_MODEL=doubao-1-5-vision-pro-32k
# VOICE_ROBOT_LINK_ENRICHMENT_MAX_URLS=3
# 视觉 OCR 失败时本地 RapidOCR 兜底: pip install rapidocr-onnxruntime
# VOICE_ROBOT_LINK_ENRICHMENT_LOCAL_OCR_FALLBACK_ENABLED=true

# LangSmith / LangChain 追踪（可选；变量名与 LangChain 文档一致，勿加 VOICE_ROBOT_ 前缀）
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=voice-robot
LANGSMITH_API_KEY=replace_with_langsmith_secret
# 若已设置 LANGSMITH_API_KEY，不必再设 LANGCHAIN_API_KEY；二者择一即可

# 可观测 / 可审计（方案见 docs/observability-and-audit.md）
# VOICE_ROBOT_AUDIT_ENABLED=true
# VOICE_ROBOT_AUDIT_DSN=sqlite:///./data/audit.db
# VOICE_ROBOT_AUDIT_STORE_USER_TEXT=true
# VOICE_ROBOT_AUDIT_MAX_USER_TEXT_CHARS=2000
# VOICE_ROBOT_AUDIT_ADMIN_API_KEY=change-me-in-production
# 前端运维仪表盘：npm run dev 后打开 http://127.0.0.1:5173/#/ops
# VOICE_ROBOT_FRONTEND_OPS_URL=http://127.0.0.1:5173/#/ops
# VOICE_ROBOT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
